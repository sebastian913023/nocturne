# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string

# ── Anthropic (required for real AI business generation + co-founder chat) ──
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_VERSION=2023-06-01
PRIMARY_MODEL=claude-sonnet-5
SECONDARY_MODEL=claude-opus-4-8
TERTIARY_MODEL=claude-haiku-4-5-20251001
MAX_TOKENS=1000
RATE_LIMIT_RPM=60

# ── Stripe (required for real $49/mo checkout) ──────────────────────────────
# Get keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
APP_URL=http://localhost:3000
